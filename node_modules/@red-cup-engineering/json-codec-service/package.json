  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run build && npm test"
  }
}
