  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/json/index.d.mts",
      "import": "./dist/json/index.mjs"
    },
    "./jsonl": {
      "types": "./dist/json/jsonl/index.d.mts",
      "import": "./dist/json/jsonl/index.mjs"
    },
    "./jsonl/eavt": {
      "types": "./dist/json/jsonl/eavt/index.d.mts",
      "import": "./dist/json/jsonl/eavt/index.mjs"
    },
    "./jsonl/eavt/datom": {
      "types": "./dist/json/jsonl/eavt/datom/index.d.mts",
      "import": "./dist/json/jsonl/eavt/datom/index.mjs"
    },
    "./jsonl/eavt/triple": {
      "types": "./dist/json/jsonl/eavt/triple/index.d.mts",
      "import": "./dist/json/jsonl/eavt/triple/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "dependencies": {
    "@lenticule-science/articulating": "0.2.2",
    "@red-cup-engineering/cryptographic-integrity-service": "0.1.3",
